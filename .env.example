# Admin panel (Supabase). Copy to .env.local and fill in.
NEXT_PUBLIC_SUPABASE_URL=https://<project-ref>.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_...
# Server only. Supabase dashboard → Project Settings → API keys → secret key.
# Used to let invited (not yet registered) admins receive their first sign-in link.
SUPABASE_SECRET_KEY=

# Public origin of the admin panel (sign-in links point here). Required in production.
ADMIN_ORIGIN=https://admin.example.org

# Public origin of the member portal (/socio). Falls back to ADMIN_ORIGIN.
PORTAL_ORIGIN=https://example.org
